{
  "name": "yk-tetris",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "yk-tetris maintainers <noreply@users.noreply.github.com>",
  "description": "A browser Minecraft-style voxel sandbox (yk-minecraft) built with Vite, TypeScript, Three.js, and Electron.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "python3 scripts/make-icon.py",
    "electron:dev": "npm run build && electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/three": "^0.185.1",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "com.yk.minecraft",
    "productName": "yk-minecraft",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "maintainer": "yk-minecraft maintainers <noreply@users.noreply.github.com>",
      "artifactName": "yk-minecraft-${version}-linux-x86_64.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "artifactName": "yk-minecraft-${version}-win-x64-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "yk-minecraft-Setup-${version}-win-x64.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.games",
      "identity": null,
      "artifactName": "yk-minecraft-${version}-mac-${arch}.${ext}"
    }
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
